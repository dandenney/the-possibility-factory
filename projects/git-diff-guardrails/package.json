{
  "name": "diffrails",
  "version": "0.1.0",
  "description": "Turn the conventions in AGENTS.md / CLAUDE.md into pre-commit checks on the git diff.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dandenney/the-possibility-factory.git",
    "directory": "projects/git-diff-guardrails"
  },
  "homepage": "https://github.com/dandenney/the-possibility-factory/tree/main/projects/git-diff-guardrails#readme",
  "bugs": "https://github.com/dandenney/the-possibility-factory/issues",
  "bin": {
    "diffrails": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "keywords": [
    "git",
    "pre-commit",
    "hooks",
    "agents",
    "AGENTS.md",
    "CLAUDE.md",
    "lint"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "diffrails": "node src/cli.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
