{
  "name": "dry-county",
  "version": "0.1.0",
  "private": true,
  "description": "A Prohibition-era moonshine game in the browser. Scene one: mix corn, sugar and water into mash, let it work, and run it through the still.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/limelight": "^5.3.0"
  }
}
