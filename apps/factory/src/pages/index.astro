---
import { countSignalsByStatus, IDEA_STATUSES, listIdeas } from "@factory/core";
import Layout from "@/layouts/Layout.astro";
import { getDb } from "@/lib/db";
import { ideaStatusLabels, timeAgo } from "@/lib/labels";

const db = await getDb();
const [ideas, signalCounts] = await Promise.all([listIdeas(db), countSignalsByStatus(db)]);
const columns = IDEA_STATUSES.filter((s) => s !== "archived").map((status) => ({
  status,
  ideas: ideas.filter((i) => i.status === status),
}));
const archivedCount = ideas.filter((i) => i.status === "archived").length;
const newSignals = signalCounts.new ?? 0;
---

<Layout title="Board">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="label">Idea line</p>
      <h1 class="text-2xl font-semibold tracking-tight">Board</h1>
    </div>
    <a href="/signals" class="text-sm text-muted hover:text-ink">
      <span class="font-mono text-ink tabular-nums">{newSignals}</span> unprocessed signal{newSignals === 1 ? "" : "s"} &rarr;
    </a>
  </div>

  <form method="post" action="/ideas/new" class="mb-8 flex gap-2">
    <input class="field" name="title" placeholder="Quick idea: what if..." required aria-label="Idea title" />
    <button class="btn shrink-0" type="submit">Add to inbox</button>
  </form>

  <div class="grid gap-4 md:grid-cols-3 xl:grid-cols-5">
    {
      columns.map((col) => (
        <section class="flex min-h-40 flex-col rounded-lg border border-rule bg-panel/60">
          <header class="flex items-center justify-between border-b border-rule px-3 py-2">
            <h2 class="label">{ideaStatusLabels[col.status]}</h2>
            <span class="font-mono text-xs text-muted tabular-nums">{col.ideas.length}</span>
          </header>
          <ul class="flex flex-col gap-2 p-2">
            {col.ideas.map((idea) => (
              <li>
                <a
                  href={`/ideas/${idea.id}`}
                  class="block rounded-md border border-rule bg-panel p-3 transition-colors hover:border-ink"
                >
                  <p class="text-sm leading-snug font-medium">{idea.title}</p>
                  {idea.pitch && <p class="mt-1 line-clamp-2 text-xs text-muted">{idea.pitch}</p>}
                  <p class="mt-2 flex gap-2 text-[0.6875rem] text-muted">
                    <span>{timeAgo(idea.updatedAt)}</span>
                    {idea.signalCount > 0 && <span>· {idea.signalCount} signal{idea.signalCount === 1 ? "" : "s"}</span>}
                    {idea.origin === "automation" && <span>· generated</span>}
                  </p>
                </a>
              </li>
            ))}
            {col.ideas.length === 0 && <li class="px-1 py-4 text-center text-xs text-muted">Empty</li>}
          </ul>
        </section>
      ))
    }
  </div>
  {archivedCount > 0 && <p class="mt-6 text-xs text-muted">{archivedCount} archived</p>}
</Layout>
