---
import "@/styles/global.css";
import { authEnabled } from "@/lib/auth";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Board" },
  { href: "/signals", label: "Signals" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · The Possibility Factory</title>
  </head>
  <body class="min-h-dvh">
    <header class="border-b border-rule bg-panel">
      <div class="mx-auto flex max-w-7xl items-center gap-6 px-5 py-3">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="inline-block size-2.5 rounded-full bg-signal" aria-hidden="true"></span>
          The Possibility Factory
        </a>
        <nav class="flex gap-1 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-2.5 py-1",
                  isActive(item.href) ? "bg-ink text-paper" : "text-muted hover:text-ink",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a href="/signals#capture" class="btn btn-ghost">+ Signal</a>
          <a href="/ideas/new" class="btn">+ Idea</a>
          {
            authEnabled && (
              <form method="post" action="/logout">
                <button class="label px-2 hover:text-ink" type="submit">
                  Log out
                </button>
              </form>
            )
          }
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-5 py-8">
      <slot />
    </main>
  </body>
</html>
